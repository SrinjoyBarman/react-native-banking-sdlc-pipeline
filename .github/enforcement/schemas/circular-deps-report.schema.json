{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CircularDepsReport",
  "description": "Output of sdlc-g2.4-circular-deps written to pipeline-output/03-quality/circular-deps-report.json.",
  "type": "object",
  "required": ["agent", "gate_id", "executed_at", "modules_checked", "total_cycles", "status"],
  "properties": {
    "agent":               { "type": "string", "const": "sdlc-g2.4-circular-deps" },
    "gate_id":             { "type": "string", "const": "SDLC_G2.4_CIRCULAR_DEPS" },
    "executed_at":         { "type": "string", "format": "date-time" },
    "exit_code":           { "type": "integer" },
    "modules_checked":     { "type": "integer" },
    "modules_with_cycles": { "type": "integer" },
    "total_cycles":        { "type": "integer" },
    "blocking":            { "type": "boolean" },
    "status":              { "type": "string", "enum": ["PASSED", "WARN", "FAILED"] },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cycle_id", "module", "severity", "cycle_depth", "files", "cycle_path"],
        "properties": {
          "cycle_id":    { "type": "integer" },
          "module":      { "type": "string" },
          "severity":    { "type": "string", "enum": ["major", "critical"] },
          "cycle_depth": { "type": "integer" },
          "files":       { "type": "array", "items": { "type": "string" } },
          "cycle_path":  { "type": "string" }
        }
      }
    },
    "affected_modules": { "type": "array", "items": { "type": "string" } },
    "gate_result":      { "type": "string", "enum": ["PASSED", "WARN", "FAILED"] }
  }
}
