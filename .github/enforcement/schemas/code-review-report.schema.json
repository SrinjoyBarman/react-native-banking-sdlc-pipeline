{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Review Report Schema",
  "type": "object",
  "required": ["agent", "gate_id", "executed_at", "files_reviewed", "total_bugs", "status"],
  "properties": {
    "agent": { "type": "string", "const": "sdlc-g3-code-reviewer" },
    "gate_id": { "type": "string", "const": "SDLC_G3_REVIEW" },
    "executed_at": { "type": "string", "format": "date-time" },
    "files_reviewed": { "type": "integer", "minimum": 0 },
    "total_bugs": { "type": "integer", "minimum": 0 },
    "critical": { "type": "integer", "minimum": 0 },
    "major": { "type": "integer", "minimum": 0 },
    "minor": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["PASSED", "WARN", "FAILED"] },
    "file_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "bugs"],
        "properties": {
          "file": { "type": "string" },
          "bugs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "severity", "line", "category", "description", "fix"],
              "properties": {
                "id": { "type": "integer" },
                "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
                "line": { "type": "integer", "minimum": 1 },
                "category": { "type": "string" },
                "description": { "type": "string" },
                "fix": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "summary_by_category": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "critical": { "type": "integer" },
          "major": { "type": "integer" },
          "minor": { "type": "integer" }
        }
      }
    },
    "equal_depth_verification": {
      "type": "object",
      "properties": {
        "files_reviewed": { "type": "integer" },
        "avg_bugs_per_file": { "type": "number" },
        "depth_variance": { "type": "number" },
        "equal_depth_enforced": { "type": "boolean" }
      }
    },
    "gate_result": { "type": "string", "enum": ["PASSED", "WARN", "FAILED"] }
  }
}
