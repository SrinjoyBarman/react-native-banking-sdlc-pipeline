{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChangeManifest",
  "description": "Generated by change-detector and consumed by all downstream pipeline agents.",
  "type": "object",
  "required": ["detection_id", "detected_at", "trigger", "total_files_changed", "files", "summary"],
  "properties": {
    "detection_id":        { "type": "string", "pattern": "^detect_\\d{8}_\\d{6}$" },
    "detected_at":         { "type": "string", "format": "date-time" },
    "trigger":             { "type": "string", "enum": ["post-merge", "post-pull", "manual"] },
    "base_commit":         { "type": "string" },
    "head_commit":         { "type": "string" },
    "total_files_changed": { "type": "integer" },
    "user_responses": {
      "type": "object",
      "properties": {
        "primary_goal":      { "type": "string" },
        "feature_module":    { "type": "string" },
        "run_pipeline":      { "type": "string" },
        "ready_for_review":  { "type": "string" },
        "change_description":{ "type": "string" },
        "tests_complete":    { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change_type", "category", "priority", "analysis_depth"],
        "properties": {
          "path":                { "type": "string" },
          "change_type":         { "type": "string", "enum": ["A", "M", "D", "R", "C"] },
          "category":            { "type": "string", "enum": ["core_logic", "tests", "native_bridges", "configuration", "scripts", "documentation"] },
          "priority":            { "type": "string", "enum": ["high", "medium", "low"] },
          "analysis_depth":      { "type": "string", "enum": ["deep", "medium", "light"] },
          "suggested_model":     { "type": "string", "enum": ["sonnet", "haiku"] },
          "affected_mfes":       { "type": "array", "items": { "type": "string" } },
          "lines_added":         { "type": "integer" },
          "lines_deleted":       { "type": "integer" },
          "estimated_complexity":{ "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "high_priority_files":     { "type": "integer" },
        "medium_priority_files":   { "type": "integer" },
        "low_priority_files":      { "type": "integer" },
        "total_lines_added":       { "type": "integer" },
        "total_lines_deleted":     { "type": "integer" },
        "affected_mfes":           { "type": "array", "items": { "type": "string" } },
        "estimated_review_time_minutes": { "type": "integer" },
        "recommended_gates":       { "type": "array", "items": { "type": "string" } }
      }
    },
    "pipeline_recommendations": {
      "type": "object",
      "properties": {
        "run_full_pipeline":     { "type": "boolean" },
        "skip_gates":            { "type": "array", "items": { "type": "string" } },
        "focus_areas":           { "type": "array", "items": { "type": "string" } },
        "estimated_tokens":      { "type": "integer" },
        "estimated_cost":        { "type": "number" },
        "estimated_duration_minutes": { "type": "integer" }
      }
    }
  }
}
